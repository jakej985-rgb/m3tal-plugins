{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DockerMonitorConfig",
  "type": "object",
  "properties": {
    "poll_interval": {
      "type": "string",
      "default": "2s",
      "description": "Interval between background metric collections (e.g. 2s, 5s, 10s)"
    },
    "docker_host": {
      "type": "string",
      "default": "unix:///var/run/docker.sock",
      "description": "Docker daemon socket or endpoint URL"
    },
    "show_all": {
      "type": "boolean",
      "default": true,
      "description": "Include stopped and exited containers in status listings"
    },
    "log_tail": {
      "type": "integer",
      "default": 100,
      "description": "Number of log lines to retrieve when querying container logs"
    }
  },
  "additionalProperties": false
}
